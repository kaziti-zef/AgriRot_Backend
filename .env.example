# --- backend ---
# APP_ENV=production refuse un secret faible. Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
JWT_SECRET=changez-moi
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
COMPUTATION_TTL_HOURS=24
# --- data-service ---
NASA_POWER_TIMEOUT_S=5
CACHE_DIR=/cache
# Sources NASA en ligne si les fichiers pré-agrégés manquent : humidité du sol (POWER GWETROOT),
# NDVI (MODIS via ORNL DAAC, téléchargé en arrière-plan), altitude et pente (SRTM via OpenTopoData).
# 0 = désactivé (tests, démo hors ligne).
DONNEES_EN_LIGNE=1
# OPENTOPODATA_URL=https://api.opentopodata.org/v1/srtm30m
# MODIS_TIMEOUT_S=90
METEOMATICS_USER=
METEOMATICS_PASSWORD=
# --- surveillance (T65) ---
MONITORING_INTERVAL_HOURS=24      # 0 = pas de tournée automatique
FORECAST_TIMEOUT_S=10
# PREVISION_SIMULEE=sec           # démo hors ligne : sec | pluie_forte | chaleur | normal
# --- backend ---
CORS_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000
# --- data-service : délais NASA POWER ---
NASA_POWER_PREFETCH_TIMEOUT_S=120
# POWER_SIMULE=1   # démo hors ligne uniquement : POWER simulé
